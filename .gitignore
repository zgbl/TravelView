# ── 真机测试产物 ── 含真实旅行照片，绝不入库
test-output/runs/

# 照片一律不进版本库（防手滑）
*.heic
*.HEIC
*.mov
*.MOV
*.jpg
*.jpeg
*.png
# 但项目自己的图标和设计稿要留下 —— 否则换台机器 clone 下来构建会失败
!Design/**/*.png
!Design/**/*.jpg
!**/Assets.xcassets/**/*.png
!**/runner/resources/*.png
!**/windows/runner/*.png
!**/web/icons/*.png
!**/web/*.png

# ── Dart / Flutter 构建产物 ──
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
.fvm/
*.iml

# ── 原生工程的生成物 ──
**/Pods/
**/.symlinks/
**/Flutter/ephemeral/
**/flutter/ephemeral/
**/android/.gradle/
**/android/local.properties
*.jks
*.keystore
xcuserdata/
DerivedData/

# ── 系统垃圾 ──
.DS_Store
_to_delete/
