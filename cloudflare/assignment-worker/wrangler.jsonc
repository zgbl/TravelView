{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travelview-access-assignment",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "https://tunnel.yourtravelview.com/secure*",
      "zone_name": "yourtravelview.com"
    }
  ],
	"r2_buckets": [
		{
			"binding": "FLAGS",
			"bucket_name": "travelview-private-flags"
		}
	],
  "observability": {
    "enabled": true
  }
}
