# ── 数据库 ──
# 任何 Postgres 都行: Neon / Supabase / 你 OCI 上那台。
# 换供应商只要换这一行，代码不动 —— 这是选 pg 而不是 Supabase SDK 的原因。
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ── Auth ──
AUTH_SECRET=用 openssl rand -base64 32 生成
AUTH_URL=http://localhost:3000

# ── Stripe ──
# **测试和正式之间切换只改这一段，代码一行不动。**
# 模式由 STRIPE_SECRET_KEY 的前缀决定: sk_test_ = 测试，sk_live_ = 正式。
# /admin 页面会显示当前模式，并用这把密钥实时核对下面 5 条 price 是否存在 ——
# price ID 字符串本身看不出 test 还是 live，换环境时最容易漏的就是它们。
#
# 三套环境各自一份 env，互不影响:
#   本地      sk_test_ + `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#             给出的 whsec_（每次 listen 都不一样）
#   测试服务器 sk_test_ + Stripe 后台 Test mode 里建的端点 whsec_
#   正式服务器 sk_live_ + Stripe 后台 Live mode 里建的端点 whsec_ + live 的 price ID
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe product 下的 5 条 price。测试和正式是两套完全不同的 ID。
STRIPE_PRICE_PRO_YEARLY=price_...     # Pro 年付 $50
STRIPE_PRICE_PRO_MONTHLY=price_...    # Pro 月付 $8
STRIPE_PRICE_CREDITS_5=price_...      # $5  = 2 篇额度
STRIPE_PRICE_CREDITS_10=price_...     # $10 = 5 篇额度
STRIPE_PRICE_CREDITS_25=price_...     # $25 = 15 篇额度

# ── 图片存哪 ──
# local: 服务器本地磁盘，nginx 直接发（当前部署用这个）
# s3:    任何 S3 兼容服务
STORAGE_DRIVER=local
MEDIA_ROOT=/var/lib/travelview/media
# 上传票据签名密钥，留空则复用 AUTH_SECRET
UPLOAD_SECRET=

# ── 对象存储（STORAGE_DRIVER=s3 时才需要）──
# OCI Object Storage:
#   S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
#   S3_REGION=<region>          例如 us-ashburn-1
#   S3_FORCE_PATH_STYLE=true
# Cloudflare R2:
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=travelview
# 图片对外地址。本地磁盘驱动下就是本站的 /media
NEXT_PUBLIC_MEDIA_BASE=https://travelview.blackrice.top/media

# ── 站点 ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 地图瓦片。上线前换成自托管的 Protomaps，见 Design/map-tiles.md
NEXT_PUBLIC_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
